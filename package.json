{
  "name": "korva-tts-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-ai-plugin.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write src/pages/PlansPage.tsx src/pages/PaymentResultPage.tsx src/pages/DashboardPage.tsx src/pages/HistoryPage.tsx src/lib/api.ts src/features/auth/AuthProvider.tsx",
    "format:check": "prettier --check src/pages/PlansPage.tsx src/pages/PaymentResultPage.tsx src/pages/DashboardPage.tsx src/pages/HistoryPage.tsx src/lib/api.ts src/features/auth/AuthProvider.tsx",
    "build:plugin": "node scripts/build-ai-plugin.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@remotion/player": "4.0.515",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.90.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "jszip": "3.10.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
